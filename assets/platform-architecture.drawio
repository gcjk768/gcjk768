<mxfile host="drawio-mcp"><diagram id="platform" name="Platform architecture"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="560" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Platform architecture: golden path, security gates and self-healing CI" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A472A;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="ci" value="Golden-path GitLab CI template library (50+ pipelines, 300 repos)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF5EC;strokeColor=#2E7D32;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#1A472A;" vertex="1" parent="1"><mxGeometry x="270" y="40" width="640" height="260" as="geometry"/></mxCell><mxCell id="aws" value="AWS (Terraform-managed)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E68A00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#7A4500;" vertex="1" parent="1"><mxGeometry x="950" y="40" width="220" height="260" as="geometry"/></mxCell><mxCell id="heal" value="Agentic self-healing loop (air-gapped, CPU-only runners, no external API calls)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#6E3FB5;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#3E1F75;" vertex="1" parent="1"><mxGeometry x="270" y="340" width="640" height="200" as="geometry"/></mxCell><mxCell id="obs" value="Reliability &amp; observability" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1F6FC5;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#0B3D75;" vertex="1" parent="1"><mxGeometry x="950" y="340" width="220" height="200" as="geometry"/></mxCell><mxCell id="dev" value="Developer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="135" width="30" height="60" as="geometry"/></mxCell><mxCell id="mr" value="Merge request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="120" height="50" as="geometry"/></mxCell><mxCell id="build" value="Build &amp; unit test&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Maven / Gradle / Node, cached runners&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="135" width="115" height="60" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Security gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;SonarQube quality gate&lt;br&gt;Fortify SAST&lt;br&gt;OWASP dependency check&lt;br&gt;Nexus IQ SBOM &amp;amp; licence&lt;br&gt;Trivy image scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="425" y="85" width="160" height="160" as="geometry"/></mxCell><mxCell id="pkg" value="Package &amp; publish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WAR / JAR / image to Nexus&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="135" width="120" height="60" as="geometry"/></mxCell><mxCell id="deploy" value="Deploy&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Terraform, CloudFormation changesets, SSM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="745" y="135" width="145" height="60" as="geometry"/></mxCell><mxCell id="eks" value="Amazon EKS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;zero-downtime cluster upgrades&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E68A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="80" width="170" height="55" as="geometry"/></mxCell><mxCell id="ecs" value="Amazon ECS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rolling deployments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E68A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="160" width="170" height="55" as="geometry"/></mxCell><mxCell id="envs" value="SIT → UAT → Non-Prod → Prod" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7A4500;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="200" height="30" as="geometry"/></mxCell><mxCell id="fail" value="Failed job&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;logs + pipeline YAML&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="395" width="115" height="60" as="geometry"/></mxCell><mxCell id="llm" value="Phase 1: LLM failure analysis&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Qwen3-Coder on Ollama&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E3FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="395" width="150" height="60" as="geometry"/></mxCell><mxCell id="gate" value="Confidence&lt;br&gt;≥ 80%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E3FB5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605" y="385" width="110" height="80" as="geometry"/></mxCell><mxCell id="draft" value="Phase 2: Draft MR&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;YAML fix on isolated branch, never auto-merged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E3FB5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="745" y="395" width="145" height="60" as="geometry"/></mxCell><mxCell id="report" value="Analysis only&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;engineer fixes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E3FB5;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="485" width="120" height="45" as="geometry"/></mxCell><mxCell id="human" value="Human review &amp;amp; approve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="400" width="120" height="50" as="geometry"/></mxCell><mxCell id="dora" value="&lt;b&gt;Pipeline Health &amp;amp; DORA dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Node.js + React 18&lt;br&gt;deploy frequency, lead time,&lt;br&gt;change failure rate, MTTR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FC5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="375" width="180" height="85" as="geometry"/></mxCell><mxCell id="es" value="GitLab API + Elasticsearch" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#FFFFFF;strokeColor=#1F6FC5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="995" y="475" width="130" height="55" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="dev" target="mr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="mr" target="build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="build" target="sec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="sec" target="pkg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="pkg" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E68A00;strokeWidth=2;" edge="1" parent="1" source="deploy" target="eks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E68A00;strokeWidth=2;" edge="1" parent="1" source="deploy" target="ecs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="on failure" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#C62828;dashed=1;fontSize=10;fontColor=#C62828;" edge="1" parent="1" source="build" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6E3FB5;strokeWidth=2;" edge="1" parent="1" source="fail" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6E3FB5;strokeWidth=2;" edge="1" parent="1" source="llm" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6E3FB5;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="gate" target="draft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6E3FB5;dashed=1;fontSize=10;" edge="1" parent="1" source="gate" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="reviewer notified" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6E3FB5;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="draft" target="human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="approved fix" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="human" target="mr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="pipeline events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1F6FC5;dashed=1;fontSize=10;fontColor=#0B3D75;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="dora"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="817.5" y="320"/><mxPoint x="1060" y="320"/></Array></mxGeometry></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1F6FC5;" edge="1" parent="1" source="es" target="dora"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>